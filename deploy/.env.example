# Settings for deploy/compose.yml. Copy to deploy/.env and fill in.
# deploy/.env is git-ignored. Never commit it or paste its values anywhere.

# --- Your Discord application (Developer Portal → your app) ---
NIRO_DISCORD_TOKEN=
NIRO_DISCORD_CLIENT_ID=
NIRO_DISCORD_CLIENT_SECRET=

# --- Where people open the dashboard (must be https) ---
# Add <NIRO_PUBLIC_URL>/auth/callback as a redirect in the Developer Portal → OAuth2.
NIRO_PUBLIC_URL=https://niro.example.com
# The domain Caddy gets a certificate for (only with the "tls" profile).
NIRO_DOMAIN=niro.example.com

# --- Passwords for the bundled Postgres and Valkey ---
# Generate long random values, for example: openssl rand -hex 32
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# --- Backups (docs/ops/backup-restore.md) ---
# BACKUP_DIR=./backups          # where dumps are written on this machine
# BACKUP_HOUR=3                 # hour of the day (UTC) for the nightly dump
# BACKUP_KEEP_DAILY=7           # daily dumps to keep
# BACKUP_KEEP_WEEKLY=3          # Sunday dumps to keep (7 + 3 weeks = at most 28 days)
# BACKUP_AGE_RECIPIENT=         # an age public key (age1...) to encrypt dumps

# --- Optional ---
# NIRO_HTTP_PORT=8080           # port on 127.0.0.1 for a reverse proxy of your own
# NIRO_LOG_LEVEL=info
# NIRO_SCAM_FEEDS=              # scam-domain lists (https URLs, comma-separated), or "off"
# NIRO_NITHRON_SITE=false       # only Nithron's own deployment sets this: it shows the Nithron
#                               # family bar and Niro's logo, which a self-hosted copy may not carry
