# Off-site copies with restic. Copy to deploy/hosted/offsite.env (chmod 600).
# The repository can be SFTP (a storage box), S3-compatible storage, or any
# other restic backend: https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html
RESTIC_REPOSITORY=
# Keep this password in the team's password manager too: without it the
# copies cannot be read.
RESTIC_PASSWORD=
# For S3-compatible storage:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OFFSITE_HOUR=4
