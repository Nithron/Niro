# Hosted Niro settings. Copy to deploy/hosted/.env on the server (chmod 600).
# Never commit it.

NIRO_VERSION=v0.1.0
NIRO_DOMAIN=niro.nithron.com
NIRO_PUBLIC_URL=https://niro.nithron.com

# The production application "Niro" (Developer Portal, owned by the Nithron team).
NIRO_DISCORD_TOKEN=
NIRO_DISCORD_CLIENT_ID=
NIRO_DISCORD_CLIENT_SECRET=

POSTGRES_PASSWORD=
VALKEY_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Backups (see deploy/compose.yml): encrypt dumps for the key held off the server.
BACKUP_AGE_RECIPIENT=

# Off-site copies of the dumps with restic (optional). Uncomment, then fill in
# offsite.env from offsite.env.example. Runbook: "Off-site copies".
# COMPOSE_PROFILES=offsite
