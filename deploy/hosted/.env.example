# Hosted Niro settings. Copy to deploy/hosted/.env on the server (chmod 600).
# Never commit it.

NIRO_VERSION=v0.1.0
NIRO_DOMAIN=niro.nithron.com
NIRO_PUBLIC_URL=https://niro.nithron.com

# The production application "Niro" (Developer Portal, owned by the Nithron team).
NIRO_DISCORD_TOKEN=
NIRO_DISCORD_CLIENT_ID=
NIRO_DISCORD_CLIENT_SECRET=

POSTGRES_PASSWORD=
VALKEY_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Backups (see deploy/compose.yml): encrypt dumps for the key held off the server.
BACKUP_AGE_RECIPIENT=

# Optional parts, comma-separated:
#   tls      Niro's own Caddy on ports 80 and 443, for a server of its own. Leave it
#            out where the host already runs a web server (runbook: "Shared server").
#   offsite  restic copies of the dumps off the server; fill in offsite.env from
#            offsite.env.example (runbook: "Off-site copies").
COMPOSE_PROFILES=tls
