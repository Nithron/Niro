# Copy to .env and fill in the Discord values (see docs/dev-setup.md).
# .env is git-ignored. Never commit or paste the token or client secret.

# --- Discord application ("Nithro Dev" for development) ---
NITHRO_DISCORD_TOKEN=
NITHRO_DISCORD_CLIENT_ID=
NITHRO_DISCORD_CLIENT_SECRET=
# Register slash commands in this server only (instant). Leave empty in production.
NITHRO_DEV_GUILD_ID=

# --- Everything below has working development defaults ---
# NITHRO_ENV=development              # or production
# NITHRO_LOG_LEVEL=info               # debug | info | warn | error
# NITHRO_LOG_FORMAT=text              # text | json
# NITHRO_HTTP_ADDR=:8080              # dashboard + API
# NITHRO_OPS_ADDR=:9090               # /healthz /readyz /metrics (keep internal)
# NITHRO_PUBLIC_URL=http://localhost:8080
# NITHRO_DASHBOARD_URL=http://localhost:5173   # only when running the Vite dev server
# NITHRO_DATABASE_URL=postgres://nithro:nithro@localhost:5432/nithro?sslmode=disable
# NITHRO_VALKEY_ADDR=localhost:6379
# NITHRO_VALKEY_PASSWORD=
