# Copy to .env and fill in the Discord values (see docs/dev-setup.md).
# .env is git-ignored. Never commit or paste the token or client secret.

# --- Discord application ("Niro Dev" for development) ---
NIRO_DISCORD_TOKEN=
NIRO_DISCORD_CLIENT_ID=
NIRO_DISCORD_CLIENT_SECRET=
# Register slash commands in this server only (instant). Leave empty in production.
NIRO_DEV_GUILD_ID=

# --- Everything below has working development defaults ---
# NIRO_ENV=development              # or production
# NIRO_LOG_LEVEL=info               # debug | info | warn | error
# NIRO_LOG_FORMAT=text              # text | json
# NIRO_HTTP_ADDR=:8080              # dashboard + API
# NIRO_OPS_ADDR=:9090               # /healthz /readyz /metrics (keep internal)
# NIRO_PUBLIC_URL=http://localhost:8080
# NIRO_DASHBOARD_URL=http://localhost:5173   # only when running the Vite dev server
# NIRO_DATABASE_URL=postgres://niro:niro@localhost:5432/niro?sslmode=disable
# NIRO_VALKEY_ADDR=localhost:6379
# NIRO_VALKEY_PASSWORD=
